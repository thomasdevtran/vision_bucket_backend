{
  "name": "express-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "devstart": "nodemon src/server.js",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:emulator",
    "test:unit": "node --test test/authenticate.test.js test/normalized-data-model.test.js test/routes-auth.test.js test/unit/validation.test.js test/unit/recommendations.test.js test/unit/movies.test.js test/unit/follows.test.js",
    "test:emulator": "firebase emulators:exec --project demo-vision-bucket --only auth,firestore \"node --test test/integration/api.emulator.test.js\"",
    "build": "node scripts/check-build.js",
    "migrate:normalized": "node scripts/migrate-normalized-records.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:prod": "npm run audit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "firebase-admin": "^14.3.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "firebase-tools": "^15.28.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}
